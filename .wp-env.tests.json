{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": "WordPress/WordPress#6.9",
	"port": 8889,
	"phpVersion": "8.0",
	"testsEnvironment": false,
	"plugins": [
		"./wp-env/plugins/easy-digital-downloads-pro",
		"./wp-env/plugins/edd-software-licensing",
		"./edd-composer"
	],
	"config": {
		"EDD_COMPOSER_ALLOW_INSECURE_HTTP": true,
		"WP_ENVIRONMENT_TYPE": "local",
		"WP_DEBUG": true,
		"WP_DEBUG_DISPLAY": true,
		"SCRIPT_DEBUG": true
	},
	"mappings": {
		"composer.json": "./wp-env/phpunit/composer.json",
		"composer.lock": "./wp-env/phpunit/composer.lock",
		"tests": "./tests/php"
	}
}
