{
	"name": "code-amp/edd-composer",
	"description": "Development tooling for EDD Composer Extension.",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"php-stubs/wordpress-stubs": "6.9.0",
		"phpcompatibility/php-compatibility": "^10.0@dev",
		"phpcompatibility/phpcompatibility-wp": "^3.0@dev",
		"phpcompatibility/phpcompatibility-paragonie": "^2.0@dev",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.0",
		"squizlabs/php_codesniffer": "^3.13",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.2"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"phpcs": "phpcs --standard=phpcs.xml.dist",
		"phpcbf": "phpcbf --standard=phpcs.xml.dist",
		"phpstan": "phpstan analyse --configuration=phpstan.dist.neon --memory-limit=1G"
	}
}
