{
	"name": "edd-composer",
	"version": "1.0.0",
	"packageManager": "pnpm@12.4.2",
	"private": true,
	"description": "Expose eligible Easy Digital Downloads products as authenticated Composer packages.",
	"author": "Code Amp",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"composer",
		"easy-digital-downloads",
		"wordpress"
	],
	"homepage": "https://github.com/Code-Amp/edd-composer",
	"repository": "git+https://github.com/Code-Amp/edd-composer.git",
	"bugs": {
		"url": "https://github.com/Code-Amp/edd-composer/issues"
	},
	"engines": {
		"node": "^20.19.0 || >=22.13.0",
		"pnpm": "12.4.2"
	},
	"devDependencies": {
		"@wordpress/env": "11.15.0",
		"@wordpress/scripts": "35.0.0",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"scripts": {
		"build": "wp-scripts build --output-path=edd-composer/assets",
		"start": "wp-scripts start --output-path=edd-composer/assets",
		"format": "wp-scripts format",
		"lint": "pnpm run lint:js && pnpm run lint:package && pnpm run lint:php",
		"lint:js": "wp-scripts lint-js",
		"lint:package": "wp-scripts lint-pkg-json",
		"lint:php": "composer run phpcs",
		"test": "pnpm run test:unit:js && pnpm run test:unit",
		"test:unit:js": "wp-scripts test-unit-js --passWithNoTests",
		"test:unit": "wp-env --config=.wp-env.tests.json reset && wp-env --config=.wp-env.tests.json run cli ../vendor/bin/phpunit --env-cwd=tests",
		"test:start": "wp-env --config=.wp-env.tests.json start",
		"test:clean": "wp-env --config=.wp-env.tests.json reset",
		"test:stop": "wp-env --config=.wp-env.tests.json stop",
		"test:destroy": "wp-env --config=.wp-env.tests.json destroy",
		"test:bash": "pnpm run test:start && wp-env --config=.wp-env.tests.json run cli bash",
		"wp-env:provision:tests": "wp-env --config=.wp-env.tests.json run cli composer install --no-interaction --no-progress --prefer-dist",
		"plugin-zip": "pnpm run build && zip -rFS edd-composer.zip edd-composer -x '*/.DS_Store'",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:clean": "wp-env clean all",
		"env:destroy": "wp-env destroy"
	}
}
